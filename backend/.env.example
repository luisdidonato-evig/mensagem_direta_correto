APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./evig.db
AUTO_CREATE_SCHEMA=true
CORS_ORIGINS=http://localhost:5173
REDIS_URL=redis://localhost:6379/0
DISPATCH_MODE=inline
PII_HASH_SECRET=change-me-in-production
AUDIENCE_MODE=mock
AUDIENCE_API_URL=
AUDIENCE_API_TOKEN=
AUDIENCE_TIMEOUT_SECONDS=10
AUTH_ENABLED=false
# token:ROLE:organization_id; use * only for a platform administrator
AUTH_TOKENS=change-me:ADMIN:*
HANDOFF_WEBHOOK_URL=
HANDOFF_WEBHOOK_SECRET=
HANDOFF_TIMEOUT_SECONDS=5
META_MODE=mock
META_GRAPH_VERSION=v23.0
META_ACCESS_TOKEN=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=change-me
META_APP_SECRET=
STORE_WEBHOOK_PAYLOADS=false
GATEWAY_URL=
GATEWAY_INTERNAL_KEY=
GATEWAY_CHANNEL_ACCOUNT_ID=
