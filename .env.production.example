# Copie para .env.production somente no servidor. Nunca versionar valores reais.
POSTGRES_PASSWORD=troque-por-uma-senha-aleatoria
PII_HASH_SECRET=troque-por-um-segredo-aleatorio
AUTH_ENABLED=true
AUTH_TOKENS=troque-por-um-token:ADMIN:*
PUBLIC_HOST=mensagem-direta.IP_ESTATICO.sslip.io
CORS_ORIGINS=https://mensagem-direta.IP_ESTATICO.sslip.io

# O deploy inicial fica seguro em modo demonstracao.
META_MODE=mock
AUDIENCE_MODE=mock

# Preencha quando ativar integracoes reais.
# HANDOFF_WEBHOOK_URL/SECRET são legados e não recebem novos eventos sem integração do gateway.

# Necessário para disparos: Mensagem Direta -> gateway -> Meta.
# Configure channel_account_id por empresa pela tela Conexão WABA.
GATEWAY_URL=
GATEWAY_INTERNAL_KEY=
